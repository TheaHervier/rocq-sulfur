DECLARE PLUGIN "rocq-sulfur.plugin"

{
  open Signature
  open Procq.Prim
  open Procq.Constr

  open Rel_signature
}

(** A single argument type, e.g. "(bind ty in term)".
    For technical reasons we have to move the rule for single identifiers to [ctor_ty]. *)
VERNAC ARGUMENT EXTEND arg_ty
| [ identref(id) ] ->
    { CAst.make ~loc (PAT_sort id) }
| [ "{{" lconstr(c) "}}" ] ->
    { CAst.make ~loc (PAT_base c) }
| [ "(" "bind" ne_identref_list(ids) "in" arg_ty(ty) ")" ] ->
    { CAst.make ~loc (PAT_bind (ids, ty)) }
END

(** The type of a constructor, e.g. "ty -> (bind term in term) -> term". *)
VERNAC ARGUMENT EXTEND pctor_ty
| [ identref(i) ] -> { ([], i) }
| [ identref(i) "->" pctor_ty(cty) ] ->
  {
    let (tys, rty) = cty in
    (CAst.map (fun _ -> PAT_sort i) i :: tys, rty)
  }
| [ arg_ty(ty) "->" pctor_ty(cty) ] -> { let (tys, rty) = cty in (ty :: tys, rty) }
END

(** A single sort/constructor declaration. *)
VERNAC ARGUMENT EXTEND decl
| [ identref(name) "(" identref(var_ctor) ")" ":" "Type" ] ->
  {
    CAst.make ~loc (SortDecl { name ; var_ctor = Some var_ctor })
  }
| [ identref(name) ":" "Type" ] ->
  {
    CAst.make ~loc (SortDecl { name ; var_ctor = None })
  }
| [ identref(name) ":" pctor_ty(cty) ] ->
  {
    let (arg_tys, ret_ty) = cty in
    CAst.make ~loc (CtorDecl { name ; arg_tys ; ret_ty })
  }
END

VERNAC ARGUMENT EXTEND signature
| [ "{{" decl_list(decls) "}}" ] ->
  {
    CAst.make ~loc { decls }
  }
END

VERNAC COMMAND EXTEND SulfurGenerate CLASSIFIED AS SIDEFF
| [ "Sulfur" "Generate" signature(s) ] -> { Main.generate s }
END


(* Relation generation *)

VERNAC ARGUMENT EXTEND conclusion
| [ identref(ind) constr_list(args) ] ->
  { (ind, args) }
END

VERNAC ARGUMENT EXTEND prem
| [ "Pred" constr(e) ] ->
  { CAst.make ~loc (PPremPred {ppred = e}) }
| [ "Ind" "(" identref(ind) constr_list(args) ")" ] ->
  { CAst.make ~loc (PPremInd { pind = ind ; pargs = args }) }
END

VERNAC ARGUMENT EXTEND var
| [ "(" ne_identref_list(xs) ":" constr(e) ")" ] ->
  { List.map (fun x -> (x, e)) xs }
END

VERNAC ARGUMENT EXTEND rule
| [ "Variables" ":" var_list(v) "Premises" ":" prem_list(p) "Conclusion" ":" conclusion(c) ";" ] ->
  { (List.flatten v, p, c) }
END

VERNAC ARGUMENT EXTEND rule_decl
| [ "Rule" identref(name) ":" rule(r) ] -> {
    let vars, prems, concl = r in
    CAst.make ~loc { prule_name = name ; pvars = vars ; pconclusion = concl ; ppremises = prems }
  }
END

VERNAC ARGUMENT EXTEND jdecl
| [ "Prop" ] -> { [] }
| [ constr(t) "->" jdecl(args) ] -> {t::args}
END

VERNAC ARGUMENT EXTEND arity_decl
| [ "Relation" identref(name) ":" jdecl(args) ";" ] ->
  {
    CAst.make ~loc ({ prel_name = name ; parity = args })
  }
END

VERNAC ARGUMENT EXTEND rsignature
| [ "[[" arity_decl_list(arities) rule_decl_list(rules) "]]" ] ->
  {
    CAst.make ~loc { parity_decls = arities ; prule_decls = rules }
  }
END

VERNAC COMMAND EXTEND RelGenerate CLASSIFIED AS SIDEFF
| [ "Ren" "Generate" rsignature(s) ] -> {
    main s
  }
END
