DECLARE PLUGIN "rocq-sulfur.plugin"

{
  open Signature
  open Stdarg
  open Procq.Prim
  open Procq.Constr

  open Rel_signature
}

(** Signature declaration body *)
VERNAC ARGUMENT EXTEND decl_body
| [ identref(name) "(" identref(v) ")" ":" lconstr(ty) ] ->
  { CAst.make ~loc { name ; var_ctor = Some v ; ty } }
| [ identref(name) ":" lconstr(ty) ] ->
  { CAst.make ~loc { name ; var_ctor = None ; ty } }
END

(** A single sort/constructor declaration. *)
VERNAC ARGUMENT EXTEND decl
| [ "|" decl_body(d) ] -> { d }
END

(** A signature, a list of declarations where the first may omit its pipe. *)
VERNAC ARGUMENT EXTEND signature
| [ "{{" decl_body(d) decl_list(decls) "}}" ] ->
  { CAst.make ~loc { decls = d :: decls } }
| [ "{{" decl_list(decls) "}}" ] -> { CAst.make ~loc { decls } }
END

VERNAC COMMAND EXTEND SulfurSyntax CLASSIFIED AS SIDEFF
| [ "Sulfur" "Syntax" signature(s) ] -> { Main.generate s }
END


(* Judgment generation *)

(** [| name (A B : term) : R t A ; R u B ⟹ R (c t u) C]. *)
VERNAC ARGUMENT EXTEND jdg_rule
| [ "|" ident(n) binders(bs) ":"
      lconstr_list_sep(ps, ";") "⟹" lconstr(c) ] ->
  { Jdg.{ pr_name = n ; pr_binders = bs ; pr_prems = ps ; pr_concl = c } }
END

VERNAC COMMAND EXTEND SulfurJudgment CLASSIFIED AS SIDEFF
| [ "Sulfur" "Judgment" ident(name) "{{" jdg_rule_list(rs) "}}" ] ->
  { Jdg.generate_rules name rs }
| [ "Sulfur" "Judgment" ident(name) constr(d) ] ->
  { Jdg.generate name d }
END

VERNAC ARGUMENT EXTEND conclusion
| [ identref(ind) constr_list(args) ] ->
  { (ind, args) }
END

VERNAC ARGUMENT EXTEND prem
| [ "Pred" constr(e) ] ->
  { CAst.make ~loc (PPremPred {ppred = e}) }
| [ "Ind" "(" identref(ind) constr_list(args) ")" ] ->
  { CAst.make ~loc (PPremInd { pind = ind ; pargs = args ; pextension = None }) }
| [ "Ind" "(" "extend" ne_constr_list(e) "in" identref(ind) constr_list(args) ")" ] ->
  { CAst.make ~loc (PPremInd { pind = ind ; pargs = args ; pextension = Some e }) }
END

VERNAC ARGUMENT EXTEND var
| [ "(" ne_identref_list(xs) ":" constr(e) ")" ] ->
  { List.map (fun x -> (x, e)) xs }
END

VERNAC ARGUMENT EXTEND rule
| [ "Variables" ":" var_list(v) "Premises" ":" prem_list(p) "Conclusion" ":" conclusion(c) ";" ] ->
  { (List.flatten v, p, c) }
END

VERNAC ARGUMENT EXTEND rule_decl
| [ "Rule" identref(name) ":" rule(r) ] -> {
    let vars, prems, concl = r in
    CAst.make ~loc { prule_name = name ; pvars = vars ; pconclusion = concl ; ppremises = prems }
  }
END

VERNAC ARGUMENT EXTEND jdecl
| [ "Prop" ] -> { [] }
| [ constr(t) "->" jdecl(args) ] -> {t::args}
END

VERNAC ARGUMENT EXTEND arity_decl
| [ "Relation" identref(name) ":" jdecl(args) "," "Declaring" constr(d) "in" identref(gamma) ";" ] ->
  {
    CAst.make ~loc ({ prel_name = name ; pdecl = d ; parity = args ; pctx_name = gamma })
  }
END

VERNAC ARGUMENT EXTEND rsignature
| [ "{{" arity_decl_list(arities) rule_decl_list(rules) "}}" ] ->
  {
    CAst.make ~loc { parity_decls = arities ; prule_decls = rules }
  }
END

VERNAC COMMAND EXTEND RelGenerate CLASSIFIED AS SIDEFF
| [ "Ren" "Generate" rsignature(s) ] -> {
    main s
  }
END
